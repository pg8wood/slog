function set-app-account() {
  ensure_dependencies_installed
  APP=$1
  ACCOUNT=$2
  if [ -z "$APP" ] || [ -z "$ACCOUNT" ]; then
    echo "Usage: $0 set-app-account \"AppName\" \"AccountName\""
    exit 1
  fi
  if ! jq -e ".apps[\"$APP\"]" "$CONFIG_FILE" > /dev/null; then
    echo "App $APP not found. Use 'add-app' first."
    exit 1
  fi
  if ! jq -e ".accounts[\"$ACCOUNT\"]" "$CONFIG_FILE" > /dev/null; then
    echo "Account $ACCOUNT not found. Use 'add-account' first."
    exit 1
  fi
  jq ".apps[\"$APP\"].activeAccount = \"$ACCOUNT\"" "$CONFIG_FILE" > "$CONFIG_FILE.tmp" && mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
  echo "Set app $APP account override to $ACCOUNT"
}

function switch-app() {
  if [ ! -f "$CONFIG_FILE" ]; then
    echo "No config found. Run '$0 setup' first."
    exit 1
  fi
  if [ -z "$1" ]; then
    APPS=$(jq -r '.apps | keys[]?' "$CONFIG_FILE")
    if [ -z "$APPS" ]; then
      echo "No apps found in config. Use 'add-app' first."
      exit 1
    fi
    echo "Select a configured app to activate:"
    IFS=$'\n' read -rd '' -a APP_ARRAY <<<"$APPS"
    select CHOICE in "${APP_ARRAY[@]}"; do
      if [ -n "$CHOICE" ]; then
        NAME="$CHOICE"
        break
      else
        echo "Invalid choice"
      fi
    done
  else
    NAME="$1"
  fi
  jq ".activeApp = \"$NAME\"" "$CONFIG_FILE" > "$CONFIG_FILE.tmp" && mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
  echo "Switched active app to $NAME"
}

function switch-device() {
  if [ ! -f "$CONFIG_FILE" ]; then
    echo "No config found. Run '$0 setup' first."
    exit 1
  fi

  if [ -z "$1" ]; then
    DEVICES=$(jq -r '.devices | keys[]?' "$CONFIG_FILE")
    if [ -z "$DEVICES" ]; then
      echo "No devices found in config. Use 'add-device' first."
      exit 1
    fi
    echo "Select a configured device to activate:"
    IFS=$'\n' read -rd '' -a DEV_ARRAY <<<"$DEVICES"
    select CHOICE in "${DEV_ARRAY[@]}"; do
      if [ -n "$CHOICE" ]; then
        NAME="$CHOICE"
        break
      else
        echo "Invalid choice"
      fi
    done
  else
    NAME="$1"
  fi

  # Ensure the selected device exists and get its UDID
  UDID=$(jq -r ".devices[\"$NAME\"].udid // empty" "$CONFIG_FILE")
  if [ -z "$UDID" ] || [ "$UDID" = "null" ]; then
    echo "Device '$NAME' not found in config."
    exit 1
  fi

  # Attempt to boot (safe if already booted)
  xcrun simctl boot "$UDID" >/dev/null 2>&1 || true
  # Wait for boot completion if bootstatus is available; fallback to polling
  if xcrun simctl bootstatus "$UDID" -b >/dev/null 2>&1; then
    : # bootstatus handled the wait
  else
    # Fallback polling up to ~30s
    for i in $(seq 1 30); do
      STATE=$(xcrun simctl list devices | grep "$UDID" | sed -n 's/.*(\(Booted\|Shutdown\|Booting\|Shutting Down\)).*/\1/p' | tail -n1)
      if [ "$STATE" = "Booted" ]; then
        break
      fi
      sleep 1
    done
  fi

  jq ".activeDevice = \"$NAME\"" "$CONFIG_FILE" > "$CONFIG_FILE.tmp" && mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
  echo "Switched active device to $NAME (booted)"
}

function switch-all() {
  ensure_dependencies_installed

  if [ ! -f "$CONFIG_FILE" ]; then
    echo "No config found. Run '$0 setup' first."
    exit 1
  fi

  ACTIVE_DEVICE=$(jq -r '.activeDevice' "$CONFIG_FILE")
  ACTIVE_APP=$(jq -r '.activeApp' "$CONFIG_FILE")
  ACTIVE_ACCOUNT=$(jq -r '.activeAccount' "$CONFIG_FILE")

  # Choose device
  DEVICES=$(jq -r '.devices | keys[]?' "$CONFIG_FILE")
  if [ -z "$DEVICES" ]; then
    echo "No devices found in config. Use 'add-device' first."
    exit 1
  fi
  echo "Select device (Enter for current: $ACTIVE_DEVICE):"
  IFS=$'\n' read -rd '' -a DEV_ARRAY <<<"$DEVICES"
  for i in "${!DEV_ARRAY[@]}"; do
    idx=$((i+1))
    if [ "${DEV_ARRAY[$i]}" = "$ACTIVE_DEVICE" ]; then
      echo "  $idx) ${DEV_ARRAY[$i]} [current]"
    else
      echo "  $idx) ${DEV_ARRAY[$i]}"
    fi
  done
  read -p "Device number: " DEV_SEL
  if [ -z "$DEV_SEL" ]; then
    CHOSEN_DEVICE="$ACTIVE_DEVICE"
  else
    if ! [[ "$DEV_SEL" =~ ^[0-9]+$ ]] || [ "$DEV_SEL" -lt 1 ] || [ "$DEV_SEL" -gt ${#DEV_ARRAY[@]} ]; then
      echo "Invalid selection"
      exit 1
    fi
    CHOSEN_DEVICE="${DEV_ARRAY[$((DEV_SEL-1))]}"
  fi

  # Choose app
  APPS=$(jq -r '.apps | keys[]?' "$CONFIG_FILE")
  if [ -z "$APPS" ]; then
    echo "No apps found in config. Use 'add-app' first."
    exit 1
  fi
  echo "Select app (Enter for current: $ACTIVE_APP):"
  IFS=$'\n' read -rd '' -a APP_ARRAY <<<"$APPS"
  for i in "${!APP_ARRAY[@]}"; do
    idx=$((i+1))
    if [ "${APP_ARRAY[$i]}" = "$ACTIVE_APP" ]; then
      echo "  $idx) ${APP_ARRAY[$i]} [current]"
    else
      echo "  $idx) ${APP_ARRAY[$i]}"
    fi
  done
  read -p "App number: " APP_SEL
  if [ -z "$APP_SEL" ]; then
    CHOSEN_APP="$ACTIVE_APP"
  else
    if ! [[ "$APP_SEL" =~ ^[0-9]+$ ]] || [ "$APP_SEL" -lt 1 ] || [ "$APP_SEL" -gt ${#APP_ARRAY[@]} ]; then
      echo "Invalid selection"
      exit 1
    fi
    CHOSEN_APP="${APP_ARRAY[$((APP_SEL-1))]}"
  fi

  # Choose account
  ACCOUNTS=$(jq -r '.accounts | keys[]?' "$CONFIG_FILE")
  if [ -z "$ACCOUNTS" ]; then
    echo "No accounts found in config. Use 'add-account' first."
    exit 1
  fi
  echo "Select account (Enter for current: $ACTIVE_ACCOUNT):"
  IFS=$'\n' read -rd '' -a ACC_ARRAY <<<"$ACCOUNTS"
  for i in "${!ACC_ARRAY[@]}"; do
    idx=$((i+1))
    if [ "${ACC_ARRAY[$i]}" = "$ACTIVE_ACCOUNT" ]; then
      echo "  $idx) ${ACC_ARRAY[$i]} [current]"
    else
      echo "  $idx) ${ACC_ARRAY[$i]}"
    fi
  done
  read -p "Account number: " ACC_SEL
  if [ -z "$ACC_SEL" ]; then
    CHOSEN_ACCOUNT="$ACTIVE_ACCOUNT"
  else
    if ! [[ "$ACC_SEL" =~ ^[0-9]+$ ]] || [ "$ACC_SEL" -lt 1 ] || [ "$ACC_SEL" -gt ${#ACC_ARRAY[@]} ]; then
      echo "Invalid selection"
      exit 1
    fi
    CHOSEN_ACCOUNT="${ACC_ARRAY[$((ACC_SEL-1))]}"
  fi

  # Apply selections using existing commands (booting and foregrounding via switch-device)
  "$0" switch-device "$CHOSEN_DEVICE"
  "$0" switch-app "$CHOSEN_APP"
  "$0" switch-account "$CHOSEN_ACCOUNT"

  echo "Switched to device='$CHOSEN_DEVICE', app='$CHOSEN_APP', account='$CHOSEN_ACCOUNT'"
}

function add-interactive() {
  ensure_dependencies_installed
  if [ ! -f "$CONFIG_FILE" ]; then
    echo "No config found. Run '$0 setup' first."
    exit 1
  fi
  echo "What would you like to add?"
  select ITEM in "Device" "App" "Account" "Cancel"; do
    case "$ITEM" in
      Device)
        "$0" add-device
        break ;;
      App)
        "$0" add-app
        break ;;
      Account)
        echo "Enter account name:"
        read NAME
        "$0" add-account "$NAME"
        break ;;
      Cancel)
        echo "Cancelled."
        break ;;
      *) echo "Invalid choice" ;;
    esac
  done
}

function switch-account() {
  if [ ! -f "$CONFIG_FILE" ]; then
    echo "No config found. Run '$0 setup' first."
    exit 1
  fi

  if [ -z "$1" ]; then
    ACCOUNTS=$(jq -r '.accounts | keys[]?' "$CONFIG_FILE")
    if [ -z "$ACCOUNTS" ]; then
      echo "No accounts found in config. Use 'add-account' first."
      exit 1
    fi
    echo "Select a configured account to activate:"
    IFS=$'\n' read -rd '' -a ACC_ARRAY <<<"$ACCOUNTS"
    select CHOICE in "${ACC_ARRAY[@]}"; do
      if [ -n "$CHOICE" ]; then
        NAME="$CHOICE"
        break
      else
        echo "Invalid choice"
      fi
    done
  else
    NAME="$1"
  fi

  jq ".activeAccount = \"$NAME\"" "$CONFIG_FILE" > "$CONFIG_FILE.tmp" && mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
  echo "Switched active account to $NAME"
}

function usage() {
  cat <<EOF
Usage: $0 [command]

No arguments:
  - If no config at $CONFIG_FILE: runs 'setup'
  - If config exists: runs 'login'

Commands:
  setup                     Initialize config (v1.0.0), device, app, and account
  login                     Automate login using active app/device/account
  add-device                Add a simulator device (UDID only)
  add-app NAME              Add an app and set default coordinates
  add account NAME          Add an account; prompts for credentials
  add device                Shortcut for add-device
  add app                   Shortcut for add-app (interactive)
  add                       Interactive: pick what to add
  add-coordinates APP [DEV] Add/override coordinates for app (default or device)
  set-orientation APP [DEV] Set app orientation (default or per-device)
  set-app-account APP ACC   Set per-app account override
  switch-device NAME
                    Set the active device
  switch-app NAME
                    Set the active app
  switch-account NAME
                    Set the active account
  switch device [NAME]
                    Switch active device (interactive if NAME omitted)
  switch app [NAME]
                    Switch active app (interactive if NAME omitted)
  switch account [NAME]
                    Switch active account (interactive if NAME omitted)
  switch
                     Interactive: pick device, app, account

Options:
  -h, -H, --help    Show this help and exit
EOF
}

case "$1" in
  "")
    if [ ! -f "$CONFIG_FILE" ]; then
      setup
    else
      login
    fi
    ;;
  -h|--help|-H)
    usage
    exit 0
    ;;
  setup) setup ;;
  login) login ;;
  add-device) add-device ;;
  add-app) shift; add-app "$@" ;;
  add-coordinates) shift; add-coordinates "$@" ;;
  set-orientation) shift; set-orientation "$@" ;;
  add-account) shift; add-account "$@" ;;
  set-app-account) shift; set-app-account "$@" ;;
  switch-device) shift; switch-device "$@" ;;
  switch-app) shift; switch-app "$@" ;;
  switch-account) shift; switch-account "$@" ;;
  add)
    shift
    case "$1" in
      "") add-interactive ;;
      device) shift; add-device "$@" ;;
      app) shift; add-app "$@" ;;
      account) shift; add-account "$@" ;;
      *)
        echo "Usage: $0 add {device|app|account}"
        echo "       $0 add       # interactive: pick what to add"
        exit 1 ;;
    esac
    ;;
  switch)
    shift
    case "$1" in
      "" ) switch-all ;;
      device)
        shift; switch-device "$@" ;;
      app)
        shift; switch-app "$@" ;;
      account)
        shift; switch-account "$@" ;;
      *)
        echo "Usage: $0 switch {device|app|account} [NAME]"
        echo "       $0 switch  # interactive: pick device, app, account"
        exit 1 ;;
    esac
    ;;
  *)
    usage
    exit 1
    ;;
esac