#!/usr/bin/env bash
CONFIG_FILE="$HOME/.slog.json"
SLOG_VERSION="1.0.0"

function init_colors() {
  if [ -n "$NO_COLOR" ] || [ ! -t 1 ]; then
    C_RESET=""; C_BOLD=""; C_DIM=""; C_RED=""; C_GREEN=""; C_YELLOW=""; C_BLUE=""; C_CYAN="";
  else
    C_RESET='\033[0m'
    C_BOLD='\033[1m'
    C_DIM='\033[2m'
    C_RED='\033[31m'
    C_GREEN='\033[32m'
    C_YELLOW='\033[33m'
    C_BLUE='\033[34m'
    C_CYAN='\033[36m'
  fi
}

function prompt_xy() {
  # Usage: prompt_xy <label> [suffix] [example]
  # Sets globals: X_OUT, Y_OUT
  init_colors
  local label="$1"
  local suffix="$2"
  local example="$3"
  local line
  while true; do
    if [ -n "$example" ]; then
      printf "Enter X Y for %b%s%b %s %b(e.g., %s)%b\n" "${C_BOLD}" "$label" "${C_RESET}" "$suffix" "${C_DIM}" "$example" "${C_RESET}"
    else
      printf "Enter X Y for %b%s%b %s\n" "${C_BOLD}" "$label" "${C_RESET}" "$suffix"
    fi
    read -r line
    # trim
    line="${line#${line%%[!$' \t']*}}"; line="${line%${line##*[!$' \t']}}"
    if [[ "$line" =~ ^[0-9]+([.][0-9]+)?[[:space:]]+[0-9]+([.][0-9]+)?$ ]]; then
      X_OUT=$(awk '{print $1}' <<<"$line")
      Y_OUT=$(awk '{print $2}' <<<"$line")
      break
    else
      printf "%bInvalid input.%b Please enter two numbers like '100 300'.\n" "${C_RED}" "${C_RESET}"
    fi
  done
}

function ensure_dependencies_installed() {
  MISSING=0
  if ! command -v axe &> /dev/null; then
    echo "Error: 'axe' not found. Install via Homebrew:"
    echo "  brew tap cameroncooke/formulae && brew install axe"
    MISSING=1
  fi
  if ! command -v jq &> /dev/null; then
    echo "Error: 'jq' not found. Install via Homebrew:"
    echo "  brew install jq"
    MISSING=1
  fi
  if [ "$MISSING" -eq 1 ]; then
    exit 1
  fi
}


