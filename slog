#!/usr/bin/env bash
CONFIG_FILE="$HOME/.slog.json"

function ensure_dependencies_installed() {
  MISSING=0
  if ! command -v axe &> /dev/null; then
    echo "Error: 'axe' not found. Install via Homebrew:"
    echo "  brew tap cameroncooke/formulae && brew install axe"
    MISSING=1
  fi
  if ! command -v jq &> /dev/null; then
    echo "Error: 'jq' not found. Install via Homebrew:"
    echo "  brew install jq"
    MISSING=1
  fi
  if [ "$MISSING" -eq 1 ]; then
    exit 1
  fi
}

function ensure_config_v1() {
  if [ ! -f "$CONFIG_FILE" ]; then
    return
  fi
  CURRENT_VERSION=$(jq -r '.version // empty' "$CONFIG_FILE")
  if [ "$CURRENT_VERSION" = "1.0.0" ]; then
    return
  fi
  echo "Migrating config to version 1.0.0..."
  tmp_file="$CONFIG_FILE.tmp"
  jq '
    def devices_udid_only: (.devices // {} | to_entries | map({key: .key, value: {udid: .value.udid}}) | from_entries);
    def coords_per_device: (.devices // {} | to_entries
      | map(select(.value.coordinates != null) | {(.key): .value.coordinates})
      | add // {});
    def orientation_default: {"default": null};
    . as $old |
    {
      version: "1.0.0",
      devices: devices_udid_only,
      accounts: ($old.accounts // {}),
      apps: {
        "DefaultApp": {
          bundleId: null,
          coordinates:
            (
              coords_per_device
              | if (keys | length) > 0 then . else ({"default": ($old.devices[$old.activeDevice].coordinates // {})}) end
            ),
          orientation: orientation_default,
          activeAccount: null
        }
      },
      activeDevice: ($old.activeDevice // ((.devices // {} | keys)[0] // "")),
      activeApp: "DefaultApp",
      activeAccount: ($old.activeAccount // (($old.accounts // {} | keys)[0] // ""))
    }
  ' "$CONFIG_FILE" > "$tmp_file" && mv "$tmp_file" "$CONFIG_FILE"
  echo "Migration complete."
}

function setup() {
  ensure_dependencies_installed
  
  echo "Fetching available simulators (booted only)..."
  SIMS=$(axe list-simulators | grep "| Booted |" | awk -F'|' '{print $1 " | " $2}' | sed 's/^[ \t]*//;s/[ \t]*$//')
  if [ -z "$SIMS" ]; then
    echo "No booted simulators found! Please boot a simulator and rerun setup."
    exit 1
  fi

  echo "Select a booted simulator to set as active device:"
  IFS=$'\n' read -rd '' -a SIM_ARRAY <<<"$SIMS"
  select CHOICE in "${SIM_ARRAY[@]}"; do
    if [ -n "$CHOICE" ]; then
      UDID=$(echo "$CHOICE" | awk -F'|' '{print $1}' | xargs)
      DEVICE_NAME=$(echo "$CHOICE" | awk -F'|' '{print $2}' | xargs)
      echo "You picked: $DEVICE_NAME ($UDID)"
      break
    else
      echo "Invalid choice"
    fi
  done

  echo "Enter an app name to configure (e.g., ReceiveStock):"
  read APP_NAME

  echo "Enter bundle ID for $APP_NAME (e.g., com.example.ReceiveStock):"
  read BUNDLE_ID

  echo "Select default orientation for $APP_NAME:"
  echo "  1) Portrait"
  echo "  2) Landscape"
  read -p "Choose [1-2]: " OR_CHOICE
  case "$OR_CHOICE" in
    2) ORI="Landscape" ;;
    *) ORI="Portrait" ;;
  esac

  echo "Enter X Y for email field (default coordinates for $APP_NAME):"
  read EX EY
  echo "Enter X Y for password field:"
  read PX PY
  echo "Enter X Y for login button:"
  read LX LY

  echo "Enter username:"
  read USERNAME
  echo "Enter password:"
  read -s PASSWORD

  cat > "$CONFIG_FILE" <<EOF
{
  "version": "1.0.0",
  "devices": {
    "$DEVICE_NAME": { "udid": "$UDID" }
  },
  "apps": {
    "$APP_NAME": {
      "bundleId": "$BUNDLE_ID",
      "coordinates": {
        "default": {
          "email": { "x": $EX, "y": $EY },
          "password": { "x": $PX, "y": $PY },
          "login": { "x": $LX, "y": $LY }
        }
      },
      "orientation": { "default": "$ORI" }
    }
  },
  "accounts": {
    "default": {
      "username": "$USERNAME",
      "password": "$PASSWORD"
    }
  },
  "activeDevice": "$DEVICE_NAME",
  "activeApp": "$APP_NAME",
  "activeAccount": "default"
}
EOF

  echo "Config saved to $CONFIG_FILE"
}

function login() {
  ensure_dependencies_installed
  ensure_config_v1

  if [ ! -f "$CONFIG_FILE" ]; then
    echo "No config found. Run '$0 setup' first."
    exit 1
  fi

  ACTIVE_DEVICE=$(jq -r '.activeDevice' "$CONFIG_FILE")
  ACTIVE_APP=$(jq -r '.activeApp' "$CONFIG_FILE")
  APP_ACCOUNT=$(jq -r ".apps[\"$ACTIVE_APP\"].activeAccount // empty" "$CONFIG_FILE")
  GLOBAL_ACCOUNT=$(jq -r '.activeAccount' "$CONFIG_FILE")
  ACTIVE_ACCOUNT=${APP_ACCOUNT:-$GLOBAL_ACCOUNT}
  BUNDLE_ID=$(jq -r ".apps[\"$ACTIVE_APP\"].bundleId // empty" "$CONFIG_FILE")
  ORIENTATION=$(jq -r ".apps[\"$ACTIVE_APP\"].orientation[\"$ACTIVE_DEVICE\"] // .apps[\"$ACTIVE_APP\"].orientation.default // empty" "$CONFIG_FILE")

  UDID=$(jq -r ".devices[\"$ACTIVE_DEVICE\"].udid" "$CONFIG_FILE")
  EMAIL_X=$(jq -r ".apps[\"$ACTIVE_APP\"].coordinates[\"$ACTIVE_DEVICE\"].email.x // .apps[\"$ACTIVE_APP\"].coordinates.default.email.x" "$CONFIG_FILE")
  EMAIL_Y=$(jq -r ".apps[\"$ACTIVE_APP\"].coordinates[\"$ACTIVE_DEVICE\"].email.y // .apps[\"$ACTIVE_APP\"].coordinates.default.email.y" "$CONFIG_FILE")
  PASS_X=$(jq -r ".apps[\"$ACTIVE_APP\"].coordinates[\"$ACTIVE_DEVICE\"].password.x // .apps[\"$ACTIVE_APP\"].coordinates.default.password.x" "$CONFIG_FILE")
  PASS_Y=$(jq -r ".apps[\"$ACTIVE_APP\"].coordinates[\"$ACTIVE_DEVICE\"].password.y // .apps[\"$ACTIVE_APP\"].coordinates.default.password.y" "$CONFIG_FILE")
  LOGIN_X=$(jq -r ".apps[\"$ACTIVE_APP\"].coordinates[\"$ACTIVE_DEVICE\"].login.x // .apps[\"$ACTIVE_APP\"].coordinates.default.login.x" "$CONFIG_FILE")
  LOGIN_Y=$(jq -r ".apps[\"$ACTIVE_APP\"].coordinates[\"$ACTIVE_DEVICE\"].login.y // .apps[\"$ACTIVE_APP\"].coordinates.default.login.y" "$CONFIG_FILE")

  USERNAME=$(jq -r ".accounts[\"$ACTIVE_ACCOUNT\"].username" "$CONFIG_FILE")
  PASSWORD=$(jq -r ".accounts[\"$ACTIVE_ACCOUNT\"].password" "$CONFIG_FILE")

  if [ "$EMAIL_X" = "null" ] || [ "$EMAIL_Y" = "null" ] || [ "$PASS_X" = "null" ] || [ "$PASS_Y" = "null" ] || [ "$LOGIN_X" = "null" ] || [ "$LOGIN_Y" = "null" ]; then
    echo "Error: Missing coordinates for app '$ACTIVE_APP' (device '$ACTIVE_DEVICE' or default)."
    echo "Add them with: $0 add-coordinates \"$ACTIVE_APP\" [\"$ACTIVE_DEVICE\"]"
    exit 1
  fi

  echo "Using device: $ACTIVE_DEVICE ($UDID)"
  echo "Using app: $ACTIVE_APP"
  echo "Using account: $ACTIVE_ACCOUNT ($USERNAME)"

  # Verify the simulator is booted; do not attempt to boot automatically
  DEVICE_STATE=$(axe list-simulators | grep "$UDID" | awk -F'|' '{print $3}' | xargs)
  if [ "$DEVICE_STATE" != "Booted" ]; then
    echo "Error: Simulator $UDID is not booted (state: $DEVICE_STATE)."
    echo "Please boot the simulator manually, then rerun."
    exit 1
  fi

  if [ -n "$BUNDLE_ID" ]; then
    echo "Launching app: $BUNDLE_ID"
    xcrun simctl launch "$UDID" "$BUNDLE_ID" >/dev/null 2>&1 || true
  fi

  if [ -n "$ORIENTATION" ]; then
    echo "Setting orientation: $ORIENTATION"
    # Note: You may be prompted to grant Terminal automation permissions the first time
    osascript <<OSA || true
tell application "Simulator" to activate
tell application "System Events"
  tell process "Simulator"
    try
      click (first menu item whose name starts with "$ACTIVE_DEVICE") of menu "Window" of menu bar 1
    end try
    try
      click menu item "$ORIENTATION" of menu "Orientation" of menu item "Orientation" of menu "Device" of menu bar 1
    end try
  end tell
end tell
OSA
  fi

  axe tap -x $EMAIL_X -y $EMAIL_Y --udid "$UDID"
  axe type "$USERNAME" --udid "$UDID"

  axe tap -x $PASS_X -y $PASS_Y --udid "$UDID"
  axe type "$PASSWORD" --udid "$UDID"

  axe tap -x $LOGIN_X -y $LOGIN_Y --udid "$UDID"

  echo "Login automation completed!"
}

function add-device() {
  ensure_dependencies_installed
  ensure_config_v1

  echo "Fetching available simulators (booted only)..."
  SIMS=$(axe list-simulators | grep "| Booted |" | awk -F'|' '{print $1 " | " $2}' | sed 's/^[ \t]*//;s/[ \t]*$//')
  if [ -z "$SIMS" ]; then
    echo "No booted simulators found! Please boot a simulator and rerun add-device."
    exit 1
  fi

  echo "Select a booted simulator:"
  IFS=$'\n' read -rd '' -a SIM_ARRAY <<<"$SIMS"

  select CHOICE in "${SIM_ARRAY[@]}"; do
    if [ -n "$CHOICE" ]; then
      UDID=$(echo "$CHOICE" | awk -F'|' '{print $1}' | xargs)
      NAME=$(echo "$CHOICE" | awk -F'|' '{print $2}' | xargs)
      echo "You picked: $NAME ($UDID)"
      break
    else
      echo "Invalid choice"
    fi
  done

  jq ".devices[\"$NAME\"] = { \"udid\": \"$UDID\" }" "$CONFIG_FILE" > "$CONFIG_FILE.tmp" && mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"

  echo "Added device $NAME"

  # Offer to add per-app overrides now
  APPS=$(jq -r '.apps | keys[]?' "$CONFIG_FILE")
  if [ -n "$APPS" ]; then
    echo "Add per-app overrides (coordinates/orientation) for this device now? (y/N)"
    read yn
    case "$yn" in
      y|Y|yes|YES)
        IFS=$'\n' read -rd '' -a APP_ARRAY <<<"$APPS"
        # Append a Done option
        APP_ARRAY+=("Done")
        while true; do
          echo "Select an app to configure for $NAME (or Done):"
          select CHOICE in "${APP_ARRAY[@]}"; do
            if [ -z "$CHOICE" ]; then
              echo "Invalid choice"
              break
            fi
            if [ "$CHOICE" = "Done" ]; then
              echo "Finished adding overrides."
              break 2
            fi
            APP_NAME="$CHOICE"
            echo "Selected app: $APP_NAME"
            echo "Select orientation for $APP_NAME ($NAME):"
            echo "  1) Portrait"
            echo "  2) Landscape"
            read -p "Choose [1-2]: " OR_CHOICE2
            case "$OR_CHOICE2" in
              2) ORI2="Landscape" ;;
              *) ORI2="Portrait" ;;
            esac
            echo "Enter X Y for email field ($APP_NAME / $NAME):"
            read EX2 EY2
            echo "Enter X Y for password field ($APP_NAME / $NAME):"
            read PX2 PY2
            echo "Enter X Y for login button ($APP_NAME / $NAME):"
            read LX2 LY2
            jq ".apps[\"$APP_NAME\"].coordinates[\"$NAME\"] = { \"email\": { \"x\": $EX2, \"y\": $EY2 }, \"password\": { \"x\": $PX2, \"y\": $PY2 }, \"login\": { \"x\": $LX2, \"y\": $LY2 } } | .apps[\"$APP_NAME\"].orientation[\"$NAME\"] = \"$ORI2\"" "$CONFIG_FILE" > "$CONFIG_FILE.tmp" && mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
            echo "Added overrides for $APP_NAME ($NAME)"
            break
          done
        done
        ;;
      *) ;;
    esac
  fi
}

function add-account() {
  NAME=$1
  if [ -z "$NAME" ]; then
    echo "Usage: $0 add-account \"AccountName\""
    exit 1
  fi

  echo "Enter username:"
  read USER
  echo "Enter password:"
  read -s PASS

  jq ".accounts[\"$NAME\"] = {
    \"username\": \"$USER\",
    \"password\": \"$PASS\"
  }" "$CONFIG_FILE" > "$CONFIG_FILE.tmp" && mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"

  echo "Added account $NAME"
}

function add-app() {
  ensure_dependencies_installed
  ensure_config_v1
  APP=$1
  if [ -z "$APP" ]; then
    echo "Enter app name:"
    read APP
  fi
  if jq -e ".apps[\"$APP\"]" "$CONFIG_FILE" > /dev/null; then
    echo "App $APP already exists."
    exit 1
  fi
  echo "Enter bundle ID for $APP (e.g., com.example.App):"
  read BUNDLE_ID
  echo "Select default orientation for $APP:"
  echo "  1) Portrait"
  echo "  2) Landscape"
  read -p "Choose [1-2]: " OR_CHOICE
  case "$OR_CHOICE" in
    2) ORI="Landscape" ;;
    *) ORI="Portrait" ;;
  esac
  echo "Enter X Y for email field (default coordinates):"
  read EX EY
  echo "Enter X Y for password field:"
  read PX PY
  echo "Enter X Y for login button:"
  read LX LY
  jq ".apps[\"$APP\"] = { \"bundleId\": \"$BUNDLE_ID\", \"coordinates\": { \"default\": { \"email\": { \"x\": $EX, \"y\": $EY }, \"password\": { \"x\": $PX, \"y\": $PY }, \"login\": { \"x\": $LX, \"y\": $LY } } }, \"orientation\": { \"default\": \"$ORI\" } }" "$CONFIG_FILE" > "$CONFIG_FILE.tmp" && mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
  echo "Added app $APP"

  # Offer to add per-device overrides now
  DEVICES=$(jq -r '.devices | keys[]?' "$CONFIG_FILE")
  if [ -n "$DEVICES" ]; then
    echo "Add per-device overrides (coordinates/orientation) now? (y/N)"
    read yn
    case "$yn" in
      y|Y|yes|YES)
        IFS=$'\n' read -rd '' -a DEV_ARRAY <<<"$DEVICES"
        # Append a Done option
        DEV_ARRAY+=("Done")
        while true; do
          echo "Select a device to configure (or Done):"
          select CHOICE in "${DEV_ARRAY[@]}"; do
            if [ -z "$CHOICE" ]; then
              echo "Invalid choice"
              break
            fi
            if [ "$CHOICE" = "Done" ]; then
              echo "Finished adding overrides."
              break 2
            fi
            DEVICE_NAME="$CHOICE"
            echo "Selected: $DEVICE_NAME"
            echo "Select orientation for $APP ($DEVICE_NAME):"
            echo "  1) Portrait"
            echo "  2) Landscape"
            read -p "Choose [1-2]: " OR_CHOICE2
            case "$OR_CHOICE2" in
              2) ORI2="Landscape" ;;
              *) ORI2="Portrait" ;;
            esac
            echo "Enter X Y for email field ($APP / $DEVICE_NAME):"
            read EX2 EY2
            echo "Enter X Y for password field ($APP / $DEVICE_NAME):"
            read PX2 PY2
            echo "Enter X Y for login button ($APP / $DEVICE_NAME):"
            read LX2 LY2
            jq ".apps[\"$APP\"].coordinates[\"$DEVICE_NAME\"] = { \"email\": { \"x\": $EX2, \"y\": $EY2 }, \"password\": { \"x\": $PX2, \"y\": $PY2 }, \"login\": { \"x\": $LX2, \"y\": $LY2 } } | .apps[\"$APP\"].orientation[\"$DEVICE_NAME\"] = \"$ORI2\"" "$CONFIG_FILE" > "$CONFIG_FILE.tmp" && mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
            echo "Added overrides for $APP ($DEVICE_NAME)"
            break
          done
        done
        ;;
      *) ;;
    esac
  fi
}

function set-orientation() {
  ensure_dependencies_installed
  ensure_config_v1
  APP=$1
  DEVICE_NAME=$2
  if [ -z "$APP" ]; then
    echo "Usage: $0 set-orientation \"AppName\" [\"Device Name\"]"
    exit 1
  fi
  if ! jq -e ".apps[\"$APP\"]" "$CONFIG_FILE" > /dev/null; then
    echo "App $APP not found. Use 'add-app' first."
    exit 1
  fi
  KEY=${DEVICE_NAME:-default}
  echo "Select orientation for $APP ($KEY):"
  echo "  1) Portrait"
  echo "  2) Landscape"
  read -p "Choose [1-2]: " OR_CHOICE
  case "$OR_CHOICE" in
    2) ORI="Landscape" ;;
    *) ORI="Portrait" ;;
  esac
  jq ".apps[\"$APP\"].orientation[\"$KEY\"] = \"$ORI\"" "$CONFIG_FILE" > "$CONFIG_FILE.tmp" && mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
  echo "Set orientation for $APP ($KEY) to $ORI"
}

function add-coordinates() {
  ensure_dependencies_installed
  ensure_config_v1
  APP=$1
  DEVICE_NAME=$2
  if [ -z "$APP" ]; then
    echo "Usage: $0 add-coordinates \"AppName\" [\"Device Name\"]"
    exit 1
  fi
  if ! jq -e ".apps[\"$APP\"]" "$CONFIG_FILE" > /dev/null; then
    echo "App $APP not found. Use 'add-app' first."
    exit 1
  fi
  KEY=${DEVICE_NAME:-default}
  echo "Enter X Y for email field ($APP / $KEY):"
  read EX EY
  echo "Enter X Y for password field:"
  read PX PY
  echo "Enter X Y for login button:"
  read LX LY
  jq ".apps[\"$APP\"].coordinates[\"$KEY\"] = { \"email\": { \"x\": $EX, \"y\": $EY }, \"password\": { \"x\": $PX, \"y\": $PY }, \"login\": { \"x\": $LX, \"y\": $LY } }" "$CONFIG_FILE" > "$CONFIG_FILE.tmp" && mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
  echo "Updated coordinates for $APP ($KEY)"
}

function set-app-account() {
  ensure_dependencies_installed
  ensure_config_v1
  APP=$1
  ACCOUNT=$2
  if [ -z "$APP" ] || [ -z "$ACCOUNT" ]; then
    echo "Usage: $0 set-app-account \"AppName\" \"AccountName\""
    exit 1
  fi
  if ! jq -e ".apps[\"$APP\"]" "$CONFIG_FILE" > /dev/null; then
    echo "App $APP not found. Use 'add-app' first."
    exit 1
  fi
  if ! jq -e ".accounts[\"$ACCOUNT\"]" "$CONFIG_FILE" > /dev/null; then
    echo "Account $ACCOUNT not found. Use 'add-account' first."
    exit 1
  fi
  jq ".apps[\"$APP\"].activeAccount = \"$ACCOUNT\"" "$CONFIG_FILE" > "$CONFIG_FILE.tmp" && mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
  echo "Set app $APP account override to $ACCOUNT"
}

function switch-app() {
  if [ ! -f "$CONFIG_FILE" ]; then
    echo "No config found. Run '$0 setup' first."
    exit 1
  fi
  ensure_config_v1
  if [ -z "$1" ]; then
    APPS=$(jq -r '.apps | keys[]?' "$CONFIG_FILE")
    if [ -z "$APPS" ]; then
      echo "No apps found in config. Use 'add-app' first."
      exit 1
    fi
    echo "Select a configured app to activate:"
    IFS=$'\n' read -rd '' -a APP_ARRAY <<<"$APPS"
    select CHOICE in "${APP_ARRAY[@]}"; do
      if [ -n "$CHOICE" ]; then
        NAME="$CHOICE"
        break
      else
        echo "Invalid choice"
      fi
    done
  else
    NAME="$1"
  fi
  jq ".activeApp = \"$NAME\"" "$CONFIG_FILE" > "$CONFIG_FILE.tmp" && mv "$CONFIG_FILE.tmp" "$CONFIG_FILE"
  echo "Switched active app to $NAME"
}

function switch-device() {
  if [ ! -f "$CONFIG_FILE" ]; then
    echo "No config found. Run '$0 setup' first."
    exit 1
  fi

  if [ -z "$1" ]; then
    DEVICES=$(jq -r '.devices | keys[]?' "$CONFIG_FILE")
    if [ -z "$DEVICES" ]; then
      echo "No devices found in config. Use 'add-device' first."
      exit 1
    fi
    echo "Select a configured device to activate:"
    IFS=$'\n' read -rd '' -a DEV_ARRAY <<<"$DEVICES"
    select CHOICE in "${DEV_ARRAY[@]}"; do
      if [ -n "$CHOICE" ]; then
        NAME="$CHOICE"
        break
      else
        echo "Invalid choice"
      fi
    done
